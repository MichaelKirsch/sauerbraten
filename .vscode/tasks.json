{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sauerbraten: Build (Rosetta)",
      "type": "shell",
      "command": "arch -x86_64 make -C src -j$(sysctl -n hw.ncpu) client",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Sauerbraten: Run",
      "type": "shell",
      "command": "arch -x86_64 ./src/sauer_client -nolauncher -q\"$HOME/Library/Application Support/sauerbraten\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Sauerbraten: Build & Run",
      "dependsOn": ["Sauerbraten: Build (Rosetta)"],
      "type": "shell",
      "command": "arch -x86_64 ./src/sauer_client -nolauncher -q\"$HOME/Library/Application Support/sauerbraten\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Sauerbraten: Clean",
      "type": "shell",
      "command": "make -C src clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
